{
    "name": "nature-reiki",
    "version": "1.0.0",
    "private": true,
    "description": "Nature & Reiki WordPress theme",
    "devDependencies": {
        "@playwright/test": "^1.63.0",
        "eslint": "^10.12.0",
        "globals": "^17.12.0",
        "stylelint": "^17.15.0",
        "stylelint-config-standard": "^40.0.0"
    },
    "overrides": {
        "braces": "file:tools/braces-patched"
